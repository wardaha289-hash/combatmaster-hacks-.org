---
import NavbarApp from './react/Navbar';
import {
	getLocalizedPath,
	getPageLocaleSwitchHref,
	resolvePageContextFromPath,
	type PageId,
} from '../data/i18n/routing';
import { defaultLocale, locales, type LocaleCode } from '../data/i18n/locales';
import { reviewsBasePath } from '../data/reviews';
import { siteConfig } from '../data/site';
import { getBlogLocaleSwitchHref, isBlogPath } from '../data/blog/helpers';

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
}

const { locale = defaultLocale, pageId: pageIdProp } = Astro.props;
const pathContext = resolvePageContextFromPath(Astro.url.pathname);
const pageId = pageIdProp ?? pathContext.pageId ?? 'home';
const current = Astro.url.pathname;
const onBlog = isBlogPath(current);

const pageContext = onBlog
	? pathContext
	: {
			...pathContext,
			pageId: pathContext.pageId ?? pageId,
		};

function localeSwitchHref(targetLocale: LocaleCode): string {
	if (onBlog) return getBlogLocaleSwitchHref(current, targetLocale);
	return getPageLocaleSwitchHref(pageContext, targetLocale);
}

const hrefForLocale = Object.fromEntries(
	locales.map((l) => [l.code, localeSwitchHref(l.code)]),
) as Record<string, string>;

const localeMetas = locales.map((l) => ({
	code: l.code,
	name: l.name,
	nativeName: l.nativeName,
	hreflang: l.hreflang,
	region: l.region,
}));

const forumsHref = '/forums/';

const links = [
	{ id: 'home', labelKey: 'nav.home', href: getLocalizedPath('home', locale) },
	{ id: 'hacks', labelKey: 'nav.preview', edit: 'navPreview', href: getLocalizedPath('hacks', locale) },
	{ id: 'esp', labelKey: 'nav.features', edit: 'navFeatures', href: getLocalizedPath('features', locale) },
	{ id: 'pricing', labelKey: 'nav.store', edit: 'navStore', href: getLocalizedPath('pricing', locale) },
	{ id: 'updates', labelKey: 'nav.status', edit: 'navStatus', href: getLocalizedPath('updates', locale) },
	{ id: 'reviews', labelKey: 'nav.reviews', edit: 'navReviews', href: reviewsBasePath },
	{ id: 'forums', labelKey: 'nav.forums', href: forumsHref },
];

---

<NavbarApp
	client:load
	locale={locale}
	siteName={siteConfig.name}
	checkoutUrl={siteConfig.checkoutUrl}
	currentPath={current}
	homeHref={getLocalizedPath('home', locale)}
	reviewsBasePath={reviewsBasePath}
	locales={localeMetas}
	hrefForLocale={hrefForLocale}
	links={links}
/>

<style is:global>
	body.nav-lock {
		overflow: hidden;
	}

	.site-header .lang-switcher {
		position: relative;
		z-index: 130;
	}

	.site-header .lang-switcher__toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 2.15rem;
		padding: 0 0.75rem;
		border: 1px solid var(--line-soft);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-elevated) 70%, transparent);
		color: var(--ink-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		list-style: none;
		cursor: pointer;
		transition:
			color 0.15s ease,
			background 0.15s ease,
			border-color 0.15s ease;
	}

	.site-header .lang-switcher__toggle::-webkit-details-marker {
		display: none;
	}

	.site-header .lang-switcher__toggle:hover {
		color: var(--ink);
		border-color: var(--line);
		background: var(--bg-elevated);
	}

	.site-header .lang-switcher__toggle svg {
		width: 0.85rem;
		height: 0.85rem;
		opacity: 0.75;
	}

	.site-header .lang-switcher__panel {
		position: absolute;
		right: 0;
		left: auto;
		top: calc(100% + 0.45rem);
		width: min(15rem, calc(100vw - 2rem));
		min-width: 12rem;
		max-height: min(70vh, 22rem);
		overflow: auto;
		padding: 0.5rem;
		background: var(--bg-elevated);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5);
		z-index: 140;
	}

	/* Anchor below header at viewport right — avoids covering center nav links */
	@media (min-width: 1025px) {
		.site-header .lang-switcher[open] .lang-switcher__panel {
			position: fixed;
			top: calc(var(--header-h) + var(--safe-top, 0px) + 0.35rem);
			right: max(var(--page-gutter), env(safe-area-inset-right, 0px));
			left: auto;
			width: min(15rem, calc(100vw - 2rem));
		}
	}

	.site-header .lang-switcher__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.2rem;
	}

	.site-header .lang-switcher__note {
		margin: 0 0 0.5rem;
		padding: 0.45rem 0.55rem;
		border-radius: 0.55rem;
		background: color-mix(in srgb, var(--bg-elevated) 90%, #000);
		color: var(--ink-muted);
		font-size: 0.72rem;
		line-height: 1.4;
	}

	.site-header .lang-switcher__link {
		display: grid;
		gap: 0.12rem;
		padding: 0.55rem 0.65rem;
		border-radius: 0.55rem;
		color: var(--ink);
		text-decoration: none;
		transition: background 0.15s ease;
	}

	.site-header .lang-switcher__link:hover,
	.site-header .lang-switcher__link.is-current {
		background: color-mix(in srgb, var(--magenta) 12%, transparent);
	}

	.site-header .lang-switcher__native {
		font-size: 0.86rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.site-header .lang-switcher__region {
		display: none;
	}

	.site-panel .lang-switcher {
		width: 100%;
	}

	.site-panel .lang-switcher__toggle {
		width: 100%;
		justify-content: flex-start;
		height: 2.75rem;
		border-radius: var(--radius-sm);
	}

	.site-panel .lang-switcher__panel {
		position: static;
		margin-top: 0.45rem;
		max-height: 12rem;
		box-shadow: none;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding-top: var(--safe-top, env(safe-area-inset-top, 0px));
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-bottom: 1px solid transparent;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.site-header.is-scrolled,
	.site-header.is-open {
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		border-bottom-color: var(--line-soft);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
	}

	.site-header__bar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		min-height: var(--header-h);
		gap: 0.75rem;
	}

	.site-nav-wrap {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		z-index: 1;
		max-width: min(100% - 24rem, 48rem);
		pointer-events: none;
	}

	.site-nav-wrap .site-nav {
		pointer-events: auto;
	}

	.site-brand {
		position: relative;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-width: 0;
		flex: 0 0 auto;
		margin-right: auto;
		padding: 0.15rem 0.1rem 0.15rem 0;
		font-family: var(--font-display);
		text-decoration: none;
		white-space: nowrap;
	}

	.site-brand.is-popping .site-brand__mark {
		animation: nav-bubble-pop 0.55s cubic-bezier(0.34, 1.4, 0.64, 1);
	}

	.site-brand__gun-burst {
		position: absolute;
		left: 1.35rem;
		bottom: calc(100% + 0.15rem);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 4.8rem;
		height: 1.9rem;
		color: var(--magenta-soft);
		filter: drop-shadow(0 0 14px color-mix(in srgb, var(--magenta) 72%, transparent));
		animation: brand-gun-burst 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
		pointer-events: none;
		z-index: 6;
	}

	.site-brand__gun-burst-icon {
		width: 100%;
		height: 100%;
	}

	.site-brand__gun-burst-icon .m416-gun__flash {
		animation: nav-m416-flash 0.65s ease-out;
	}

	.site-brand__mark {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.85rem;
		height: 1.75rem;
		flex-shrink: 0;
		color: var(--magenta-soft);
		filter: drop-shadow(0 0 10px color-mix(in srgb, var(--magenta) 45%, transparent));
	}

	.site-brand__gun {
		width: 100%;
		height: 100%;
		transform: rotate(-8deg);
		transform-origin: 70% 50%;
		animation: brand-gun-idle 4.5s ease-in-out infinite;
	}

	.site-brand__reticle {
		position: absolute;
		left: -0.2rem;
		top: 50%;
		width: 0.55rem;
		height: 0.55rem;
		margin-top: -0.275rem;
		border: 1px solid color-mix(in srgb, var(--magenta-soft) 70%, transparent);
		border-radius: 999px;
		opacity: 0.55;
		animation: brand-reticle-pulse 3.2s ease-in-out infinite;
	}

	.site-brand__reticle::before,
	.site-brand__reticle::after {
		content: '';
		position: absolute;
		background: color-mix(in srgb, var(--magenta-soft) 80%, transparent);
	}

	.site-brand__reticle::before {
		left: 50%;
		top: -0.12rem;
		width: 1px;
		height: calc(100% + 0.24rem);
		transform: translateX(-50%);
	}

	.site-brand__reticle::after {
		top: 50%;
		left: -0.12rem;
		height: 1px;
		width: calc(100% + 0.24rem);
		transform: translateY(-50%);
	}

	.site-brand__muzzle {
		position: absolute;
		left: -0.08rem;
		top: 50%;
		width: 0.48rem;
		height: 0.48rem;
		margin-top: -0.24rem;
		border-radius: 999px;
		background: radial-gradient(
			circle,
			color-mix(in srgb, var(--magenta-soft) 90%, #fff) 0%,
			transparent 70%
		);
		opacity: 0;
		animation: brand-muzzle-idle 4.5s ease-in-out infinite;
	}

	.site-brand__text {
		display: inline-flex;
		align-items: baseline;
		gap: 0;
		font-size: 1.02rem;
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1;
	}

	.site-brand__combat {
		color: var(--ink);
		transition: color 0.2s ease;
	}

	.site-brand__master {
		color: var(--magenta-soft);
		text-shadow: 0 0 18px color-mix(in srgb, var(--magenta) 28%, transparent);
		transition:
			color 0.2s ease,
			text-shadow 0.2s ease;
	}

	.site-brand:hover .site-brand__combat {
		color: #fff;
	}

	.site-brand:hover .site-brand__master {
		color: #fff;
		text-shadow: 0 0 22px color-mix(in srgb, var(--magenta) 45%, transparent);
	}

	.site-brand:hover .site-brand__gun {
		animation: brand-gun-recoil 0.55s cubic-bezier(0.34, 1.25, 0.64, 1);
	}

	.site-brand:hover .site-brand__muzzle {
		animation: brand-muzzle-burst 0.55s ease-out;
	}

	.site-brand__gun .m416-gun__flash {
		animation: brand-flash-idle 4.5s ease-in-out infinite;
	}

	.site-brand:hover .site-brand__gun .m416-gun__flash {
		animation: brand-flash-burst 0.55s ease-out;
	}

	@keyframes brand-gun-burst {
		0% {
			opacity: 0;
			transform: translateX(-50%) translateY(12px) scale(0.5) rotate(-12deg);
		}
		30% {
			opacity: 1;
			transform: translateX(-50%) translateY(-8px) scale(1.15) rotate(-4deg);
		}
		70% {
			opacity: 1;
			transform: translateX(-50%) translateY(-18px) scale(1.08) rotate(-6deg);
		}
		100% {
			opacity: 0;
			transform: translateX(-50%) translateY(-32px) scale(0.92) rotate(-10deg);
		}
	}

	@keyframes brand-gun-idle {
		0%,
		100% {
			transform: rotate(-8deg) translateY(0);
		}
		50% {
			transform: rotate(-6deg) translateY(-1px);
		}
	}

	@keyframes brand-gun-recoil {
		0% {
			transform: rotate(-8deg) translateX(0);
		}
		25% {
			transform: rotate(-4deg) translateX(2px) translateY(1px);
		}
		55% {
			transform: rotate(-10deg) translateX(-1px);
		}
		100% {
			transform: rotate(-8deg) translateX(0);
		}
	}

	@keyframes brand-reticle-pulse {
		0%,
		100% {
			opacity: 0.35;
			transform: scale(0.92);
		}
		50% {
			opacity: 0.75;
			transform: scale(1);
		}
	}

	@keyframes brand-muzzle-idle {
		0%,
		88%,
		100% {
			opacity: 0;
			transform: scale(0.4);
		}
		92% {
			opacity: 0.85;
			transform: scale(1.15);
		}
	}

	@keyframes brand-muzzle-burst {
		0% {
			opacity: 0;
			transform: scale(0.3);
		}
		30% {
			opacity: 1;
			transform: scale(1.35);
		}
		100% {
			opacity: 0;
			transform: scale(1.8);
		}
	}

	@keyframes brand-flash-idle {
		0%,
		88%,
		100% {
			opacity: 0.25;
		}
		92% {
			opacity: 1;
		}
	}

	@keyframes brand-flash-burst {
		0% {
			opacity: 0.3;
		}
		35% {
			opacity: 1;
		}
		100% {
			opacity: 0.35;
		}
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.1rem;
		padding: 0.22rem;
		border: 1px solid var(--line-soft);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-elevated) 65%, transparent);
		box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 5%, transparent);
	}

	.site-nav a {
		display: inline-flex;
		align-items: center;
		gap: 0.38rem;
		padding: 0.4rem 0.8rem;
		border-radius: 999px;
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--ink-muted);
		white-space: nowrap;
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}

	.site-nav a svg {
		width: 0.88rem;
		height: 0.88rem;
		flex-shrink: 0;
		opacity: 0.72;
	}

	.site-nav a:hover {
		color: var(--ink);
		background: color-mix(in srgb, #fff 5%, transparent);
	}

	.site-nav a:hover svg,
	.site-nav a.is-active svg {
		opacity: 1;
		color: var(--magenta-soft);
	}

	.site-nav a.is-active {
		color: var(--ink);
		background: color-mix(in srgb, #fff 10%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #fff 6%, transparent);
	}

	.site-nav a.site-nav__bubble {
		position: relative;
		font-weight: 500;
		color: var(--ink-muted);
		background: transparent;
		border: 1px solid transparent;
		box-shadow: none;
	}

	.site-nav a.site-nav__bubble.is-active {
		color: var(--ink);
		background: color-mix(in srgb, #fff 10%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #fff 6%, transparent);
	}

	.site-nav a.site-nav__bubble:hover,
	.site-nav a.site-nav__bubble.is-active:hover {
		font-weight: 600;
		color: var(--magenta-soft);
		background: color-mix(in srgb, var(--magenta) 14%, transparent);
		border-color: color-mix(in srgb, var(--magenta) 32%, transparent);
		box-shadow:
			0 0 16px color-mix(in srgb, var(--magenta) 20%, transparent),
			inset 0 1px 0 color-mix(in srgb, #fff 10%, transparent);
	}

	.site-nav a.site-nav__bubble.is-popping {
		animation: nav-bubble-pop 0.55s cubic-bezier(0.34, 1.4, 0.64, 1);
	}

	.site-nav__gun-burst {
		position: absolute;
		left: 50%;
		bottom: calc(100% + 0.4rem);
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 4.6rem;
		height: 1.85rem;
		color: var(--magenta-soft);
		filter: drop-shadow(0 0 12px color-mix(in srgb, var(--magenta) 70%, transparent));
		animation: nav-gun-rise 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
		pointer-events: none;
		z-index: 5;
	}

	.site-nav__gun-icon {
		width: 100%;
		height: 100%;
	}

	.site-nav__gun-icon .m416-gun__flash {
		animation: nav-m416-flash 0.6s ease-out;
	}

	@keyframes nav-bubble-pop {
		0% {
			transform: scale(1);
		}
		35% {
			transform: scale(1.1);
			box-shadow:
				0 0 28px color-mix(in srgb, var(--magenta) 40%, transparent),
				inset 0 1px 0 color-mix(in srgb, #fff 14%, transparent);
		}
		100% {
			transform: scale(1);
		}
	}

	@keyframes nav-gun-rise {
		0% {
			opacity: 0;
			transform: translateX(-50%) translateY(12px) scale(0.5) rotate(-12deg);
		}
		30% {
			opacity: 1;
			transform: translateX(-50%) translateY(-8px) scale(1.15) rotate(-4deg);
		}
		70% {
			opacity: 1;
			transform: translateX(-50%) translateY(-18px) scale(1.08) rotate(-6deg);
		}
		100% {
			opacity: 0;
			transform: translateX(-50%) translateY(-32px) scale(0.92) rotate(-10deg);
		}
	}

	@keyframes nav-m416-flash {
		0%,
		100% {
			opacity: 0.3;
		}
		40% {
			opacity: 1;
		}
	}

	.site-tools {
		position: relative;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.45rem;
		min-width: 0;
		flex-shrink: 0;
	}

	.site-tools__buy {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 2.15rem;
		height: auto;
		padding: 0 1rem;
		border-radius: 999px;
		background: #fff;
		color: #09090b;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		transition:
			background 0.15s ease,
			transform 0.15s ease;
	}

	.site-tools__buy svg {
		width: 0.9rem;
		height: 0.9rem;
	}

	.site-tools__buy:hover {
		background: #ececef;
		color: #09090b;
		transform: translateY(-1px);
	}

	.site-menu {
		display: none;
		align-items: center;
		justify-content: center;
		width: var(--touch-min, 2.75rem);
		height: var(--touch-min, 2.75rem);
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-elevated) 75%, transparent);
		color: var(--ink);
		flex-shrink: 0;
	}

	.site-menu__bars {
		display: grid;
		gap: 3.5px;
		width: 0.95rem;
	}

	.site-menu__bars span {
		display: block;
		height: 1.5px;
		border-radius: 999px;
		background: currentColor;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
		transform-origin: center;
	}

	.site-header.is-open .site-menu__bars span:nth-child(1) {
		transform: translateY(5px) rotate(45deg);
	}

	.site-header.is-open .site-menu__bars span:nth-child(2) {
		opacity: 0;
	}

	.site-header.is-open .site-menu__bars span:nth-child(3) {
		transform: translateY(-5px) rotate(-45deg);
	}

	.site-panel {
		border-top: 1px solid var(--line-soft);
		background: var(--bg);
		padding: 0.35rem 0 max(1.35rem, env(safe-area-inset-bottom, 0px));
		max-height: min(70dvh, calc(100dvh - var(--header-h)));
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior: contain;
		animation: panel-in 0.18s ease-out;
	}

	@keyframes panel-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.site-panel__nav {
		display: grid;
	}

	.site-panel__nav a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-height: var(--touch-min, 2.75rem);
		padding: 0.85rem 0.15rem;
		font-size: 1.05rem;
		font-weight: 500;
