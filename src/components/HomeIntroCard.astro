---
import HomeIntroCardApp from './react/HomeIntroCard';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const previewSrc = '/images/combatmaster-hacks-cheat-preview.png';
---

<HomeIntroCardApp client:visible locale={locale} previewSrc={previewSrc} previewSrcSet="" />

<style is:global>
	.home-intro {
		padding-block: clamp(2rem, 4vw, 2.75rem) clamp(1.25rem, 2.5vw, 1.75rem);
	}

	.home-intro__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(260px, 440px);
		gap: clamp(1.5rem, 3.5vw, 2.5rem);
		align-items: center;
	}

	.home-intro__copy {
		padding-left: 0.85rem;
		border-left: 3px solid var(--magenta);
	}

	.home-intro__eyebrow {
		margin: 0 0 0.5rem;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home-intro__copy h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 3.5vw, 2.35rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.15;
		text-transform: capitalize;
		color: var(--ink);
		max-width: 14ch;
	}

	.home-intro__body {
		margin: 0.85rem 0 0;
		max-width: 36rem;
		font-size: 0.9rem;
		line-height: 1.65;
		color: var(--ink-muted);
	}

	.home-intro__links {
		margin: 0.65rem 0 0;
		max-width: 36rem;
		font-size: 0.9rem;
		line-height: 1.65;
		color: var(--ink-faint);
	}

	.home-intro__links a {
		font-weight: 700;
		color: var(--magenta-soft);
		text-decoration: none;
	}

	.home-intro__links a:hover {
		color: var(--ink);
	}

	.home-intro__preview {
		position: relative;
		margin: 0;
		border-radius: 0.85rem;
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--bg);
		box-shadow: 0 24px 48px rgba(0, 0, 0, 0.4);
		aspect-ratio: 16 / 10;
	}

	.home-intro__preview img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.home-intro__preview-badge {
		position: absolute;
		left: 0.85rem;
		bottom: 0.85rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		padding: 0.4rem 0.7rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, #fff 14%, transparent);
		background: color-mix(in srgb, var(--bg) 78%, transparent);
		backdrop-filter: blur(10px);
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink);
	}

	@media (max-width: 900px) {
		.home-intro__grid {
			grid-template-columns: 1fr;
		}

		.home-intro__copy {
			padding-left: 0;
			border-left: none;
		}

		.home-intro__copy h2 {
			max-width: none;
		}

		.home-intro__preview {
			max-width: 100%;
		}
	}
</style>
